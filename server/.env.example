# Copy to .env.local, then enter the API key there. Never commit the private file.
# Values are literal; matching outer quotes are optional. No shell expansion.
MEMO_ASR_PROVIDER=siliconflow
MEMO_ASR_API_KEY=
MEMO_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
MEMO_ASR_BASE_URL=https://api.siliconflow.cn
MEMO_ASR_CONCURRENCY=1
MEMO_ADDR=:8080
MEMO_DATA_DIR=./data
# Optional physical LAN interface; empty selects an active multicast IPv4 LAN.
MEMO_MDNS_INTERFACE=
